+class UNI2Encoder(VisionEncoder):
+    """UNI2 encoder implementation for histology REPA targets."""
+
+    _MODEL_SPECS = {
+        "h": {
+            "model_name": "hf_hub:MahmoodLab/UNI2-h",
+            "patch_size": 14,
+            "depth": 24,
+            "num_heads": 24,
+            "init_values": 1e-5,
+            "embed_dim": 1536,
+            "mlp_ratio": 2.66667 * 2,
+            "reg_tokens": 8,
+        },
+    }
+
+    def load_model(self):
+        import timm
+        from timm.data import resolve_data_config
+
+        spec = self._MODEL_SPECS.get(self.model_config)
+        if spec is None:
+            raise ValueError(
+                f"Unsupported UNI2 model_config={self.model_config!r}. "
+                f"Available configs: {sorted(self._MODEL_SPECS.keys())}"
+            )
+
+        self.model = timm.create_model(
+            spec["model_name"],
+            pretrained=True,
+            img_size=224,
+            patch_size=spec["patch_size"],
+            depth=spec["depth"],
+            num_heads=spec["num_heads"],
+            init_values=spec["init_values"],
+            embed_dim=spec["embed_dim"],
+            mlp_ratio=spec["mlp_ratio"],
+            num_classes=0,
+            no_embed_class=True,
+            mlp_layer=timm.layers.SwiGLUPacked,
+            act_layer=torch.nn.SiLU,
+            reg_tokens=spec["reg_tokens"],
+            dynamic_img_size=True,
+        )
+
+        cfg = resolve_data_config(self.model.pretrained_cfg, model=self.model)
+        self._image_mean = tuple(float(x) for x in cfg["mean"])
+        self._image_std = tuple(float(x) for x in cfg["std"])
+
+        self.model.requires_grad_(False)
+        self.model.eval()
